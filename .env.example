# Copy this file to .env.local and fill in your real keys.
# .env.local is already ignored by git (see .gitignore) and is never sent to the browser.

# API key for Higgsfield Soul v2 image generation (used by app/api/generate-image/route.ts).
# Format: "<id>:<secret>" (the route sends it as "Key <value>").
HIGGSFIELD_API_KEY=

# API key for Qwen-Image generation via Alibaba Model Studio (DashScope),
# international/Singapore region (used by app/api/generate-image/route.ts).
# Pay-as-you-go key starting with "sk-ws-" — NOT the Token Plan key
# (starts with "sk-sp-"), which only covers text/chat models.
QWEN_API_KEY=

# API key for Kling AI image/video generation (used by app/api/generate-image/route.ts).
KLING_API_KEY=

# Kling Motion Control: access key and secret for automatically signed JWTs.
KLING_ACCESS_KEY=
KLING_SECRET_KEY=

# A2E API token for image generation, image reference editing, and image-to-video.
A2E_API_TOKEN=

# Stripe secret key (sk_live_... / sk_test_...) used to create Checkout Sessions
# for plans and credit top-ups (used by app/api/checkout/route.ts).
STRIPE_SECRET_KEY=

# Stripe webhook signing secret (whsec_...) used to verify checkout.session.completed
# events before crediting a user's account (used by app/api/stripe-webhook/route.ts).
STRIPE_WEBHOOK_SECRET=

# Google OAuth client ID/secret for "Continue with Google" sign-in
# (used by app/api/auth/google/route.ts and app/api/auth/google/callback/route.ts).
# Create these at https://console.cloud.google.com/apis/credentials — Authorized
# redirect URI must be "<your-domain>/api/auth/google/callback".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
