# Copy this file to .env.local and fill in your real keys.
# .env.local is already ignored by git (see .gitignore) and is never sent to the browser.

# API key for Higgsfield Soul v2 image generation (used by app/api/generate-image/route.ts).
# Format: "<id>:<secret>" (the route sends it as "Key <value>").
HIGGSFIELD_API_KEY=

# API key for Qwen-Image generation via Alibaba Model Studio (DashScope),
# international/Singapore region (used by app/api/generate-image/route.ts).
# Pay-as-you-go key starting with "sk-ws-" — NOT the Token Plan key
# (starts with "sk-sp-"), which only covers text/chat models.
QWEN_API_KEY=

# API key for Kling AI image/video generation (used by app/api/generate-image/route.ts).
KLING_API_KEY=
