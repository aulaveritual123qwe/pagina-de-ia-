# Copy this file to .env.local and fill in your real key.
# .env.local is already ignored by git (see .gitignore) and is never sent to the browser.

# API key used by app/api/generate-image/route.ts to call the Higgsfield Soul v2 image
# generation API. Format: "<id>:<secret>" (the route sends it as "Key <value>").
HIGGSFIELD_API_KEY=
